# Copy to `.env` and fill in. Never commit `.env`.

NODE_ENV=development
PORT=3000

# Local MySQL 8. Create the `tradeflow` user first (see README "Database setup").
# Prisma uses the mysql:// URL for migrations; the API uses the same URL at runtime.
DATABASE_URL="mysql://tradeflow:CHANGE_ME@localhost:3306/tradeflow"
# Used only by `prisma migrate dev` to detect schema drift.
SHADOW_DATABASE_URL="mysql://tradeflow:CHANGE_ME@localhost:3306/tradeflow_shadow"
# Used by the e2e test suite. It is wiped and re-migrated on every test run.
TEST_DATABASE_URL="mysql://tradeflow:CHANGE_ME@localhost:3306/tradeflow_test"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=14

# Comma-separated list of browser origins allowed to call the API (production).
CORS_ORIGINS=http://localhost:5173
