# Copy to `.env` and fill in. Never commit `.env`.

NODE_ENV=development
PORT=3000

# Local SQL Server (default instance, TCP 1433, SQL authentication enabled).
# Create the `tradeflow` login and its databases first (see PROJECT_HANDOFF.md "Setup").
# Prisma CLI and the API (via @prisma/adapter-mssql) share this connection string.
# trustServerCertificate=true is for a local self-signed certificate only.
DATABASE_URL="sqlserver://localhost:1433;database=tradeflow;user=tradeflow;password=CHANGE_ME;encrypt=true;trustServerCertificate=true"
# Used only by `prisma migrate dev` to detect schema drift.
SHADOW_DATABASE_URL="sqlserver://localhost:1433;database=tradeflow_shadow;user=tradeflow;password=CHANGE_ME;encrypt=true;trustServerCertificate=true"
# Used by the e2e test suite. It is wiped and re-migrated on every test run.
TEST_DATABASE_URL="sqlserver://localhost:1433;database=tradeflow_test;user=tradeflow;password=CHANGE_ME;encrypt=true;trustServerCertificate=true"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=14

# Comma-separated list of browser origins allowed to call the API (production).
CORS_ORIGINS=http://localhost:5173
