// TradeFlow data model.
//
// Multi-tenancy: every business-owned row carries `tenantId`. Required relations
// use composite foreign keys (tenantId, xId) -> (tenantId, id), so SQL Server itself
// rejects a row that points at another tenant's record. Optional relations use a
// plain FK (Prisma cannot model an optional composite relation over a required
// tenantId) and are tenant-checked in the service layer, with e2e tests.
//
// Enums: SQL Server has no enum type, so they are NVARCHAR columns restricted by CHECK
// constraints (see the migration) and typed in TypeScript by src/common/enums.ts.
//
// Money: DECIMAL(14,2). Quantities: whole units (INT). Text: NVARCHAR (Unicode, for Arabic).
// SQL Server has no RESTRICT; NO ACTION gives the same "reject the delete" guarantee.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "sqlserver"
}

model Tenant {
  id             Int      @id @default(autoincrement())
  name           String   @db.NVarChar(120)
  currency       String   @default("EGP") @db.Char(3)
  defaultTaxRate Decimal  @default(0) @db.Decimal(5, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users            User[]
  categories       Category[]
  products         Product[]
  stockMovements   StockMovement[]
  customers        Customer[]
  customerPrices   CustomerPrice[]
  suppliers        Supplier[]
  salesOrders      SalesOrder[]
  purchaseOrders   PurchaseOrder[]
  customerPayments CustomerPayment[]
  supplierPayments SupplierPayment[]
  sequences        DocumentSequence[]
  activities       ActivityLog[]
}

model User {
  id           Int       @id @default(autoincrement())
  tenantId     Int
  name         String    @db.NVarChar(120)
  email        String    @unique @db.NVarChar(190)
  passwordHash String    @db.NVarChar(255)
  role         String    @default("STAFF") @db.NVarChar(20) // Role (src/common/enums.ts; CHECK in migration)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  refreshTokens RefreshToken[]

  @@unique([tenantId, id])
  @@index([tenantId])
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique @db.Char(64)
  family    String    @db.Char(36)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@index([family])
}

model Category {
  id        Int      @id @default(autoincrement())
  tenantId  Int
  name      String   @db.NVarChar(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  products Product[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
}

model Product {
  id           Int      @id @default(autoincrement())
  tenantId     Int
  categoryId   Int?
  sku          String   @db.NVarChar(60)
  name         String   @db.NVarChar(160)
  unit         String   @default("piece") @db.NVarChar(30)
  costPrice    Decimal  @default(0) @db.Decimal(14, 2)
  salePrice    Decimal  @db.Decimal(14, 2)
  stockQty     Int      @default(0)
  reorderLevel Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  category           Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  stockMovements     StockMovement[]
  customerPrices     CustomerPrice[]
  salesOrderItems    SalesOrderItem[]
  purchaseOrderItems PurchaseOrderItem[]

  @@unique([tenantId, id])
  @@unique([tenantId, sku])
  @@index([tenantId, name])
  @@index([tenantId, isActive])
}

model StockMovement {
  id           Int      @id @default(autoincrement())
  tenantId     Int
  productId    Int
  type         String   @db.NVarChar(20) // StockMovementType (src/common/enums.ts; CHECK in migration)
  quantity     Int
  balanceAfter Int
  refType      String?  @db.NVarChar(30)
  refId        Int?
  note         String?  @db.NVarChar(255)
  userId       Int
  createdAt    DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product Product @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId, productId, createdAt])
  @@index([tenantId, createdAt])
}

model Customer {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  name        String   @db.NVarChar(160)
  phone       String?  @db.NVarChar(40)
  email       String?  @db.NVarChar(190)
  address     String?  @db.NVarChar(255)
  taxNumber   String?  @db.NVarChar(60)
  creditLimit Decimal? @db.Decimal(14, 2)
  notes       String?  @db.NVarChar(Max)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  prices      CustomerPrice[]
  salesOrders SalesOrder[]
  payments    CustomerPayment[]

  @@unique([tenantId, id])
  @@index([tenantId, name])
}

model CustomerPrice {
  id         Int      @id @default(autoincrement())
  tenantId   Int
  customerId Int
  productId  Int
  price      Decimal  @db.Decimal(14, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customer Customer @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)
  product  Product  @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenantId, customerId, productId])
}

model Supplier {
  id        Int      @id @default(autoincrement())
  tenantId  Int
  name      String   @db.NVarChar(160)
  phone     String?  @db.NVarChar(40)
  email     String?  @db.NVarChar(190)
  address   String?  @db.NVarChar(255)
  taxNumber String?  @db.NVarChar(60)
  notes     String?  @db.NVarChar(Max)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  purchaseOrders PurchaseOrder[]
  payments       SupplierPayment[]

  @@unique([tenantId, id])
  @@index([tenantId, name])
}

model SalesOrder {
  id          Int       @id @default(autoincrement())
  tenantId    Int
  number      String    @db.NVarChar(30)
  customerId  Int
  status      String    @default("DRAFT") @db.NVarChar(20) // SalesOrderStatus (src/common/enums.ts; CHECK in migration)
  orderDate   DateTime  @default(now())
  subtotal    Decimal   @default(0) @db.Decimal(14, 2)
  discount    Decimal   @default(0) @db.Decimal(14, 2)
  taxRate     Decimal   @default(0) @db.Decimal(5, 2)
  taxAmount   Decimal   @default(0) @db.Decimal(14, 2)
  total       Decimal   @default(0) @db.Decimal(14, 2)
  notes       String?   @db.NVarChar(Max)
  createdById Int
  confirmedAt DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customer Customer          @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  items    SalesOrderItem[]
  payments CustomerPayment[]

  @@unique([tenantId, id])
  @@unique([tenantId, number])
  @@index([tenantId, customerId, status])
  @@index([tenantId, status, confirmedAt])
}

model SalesOrderItem {
  id           Int     @id @default(autoincrement())
  tenantId     Int
  salesOrderId Int
  productId    Int
  productName  String  @db.NVarChar(160)
  sku          String  @db.NVarChar(60)
  quantity     Int
  unitPrice    Decimal @db.Decimal(14, 2)
  /// Cost snapshot taken at confirmation, for gross-profit reporting. Never sent to STAFF.
  unitCost     Decimal @default(0) @db.Decimal(14, 2)
  lineTotal    Decimal @db.Decimal(14, 2)

  salesOrder SalesOrder @relation(fields: [tenantId, salesOrderId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)
  product    Product    @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId, productId])
}

model PurchaseOrder {
  id           Int       @id @default(autoincrement())
  tenantId     Int
  number       String    @db.NVarChar(30)
  supplierId   Int
  status       String    @default("DRAFT") @db.NVarChar(20) // PurchaseOrderStatus (src/common/enums.ts; CHECK in migration)
  orderDate    DateTime  @default(now())
  expectedDate DateTime?
  total        Decimal   @default(0) @db.Decimal(14, 2)
  notes        String?   @db.NVarChar(Max)
  createdById  Int
  orderedAt    DateTime?
  receivedAt   DateTime?
  cancelledAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  supplier Supplier            @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  items    PurchaseOrderItem[]
  payments SupplierPayment[]

  @@unique([tenantId, id])
  @@unique([tenantId, number])
  @@index([tenantId, supplierId, status])
}

model PurchaseOrderItem {
  id              Int     @id @default(autoincrement())
  tenantId        Int
  purchaseOrderId Int
  productId       Int
  productName     String  @db.NVarChar(160)
  sku             String  @db.NVarChar(60)
  quantity        Int
  unitCost        Decimal @db.Decimal(14, 2)
  lineTotal       Decimal @db.Decimal(14, 2)

  purchaseOrder PurchaseOrder @relation(fields: [tenantId, purchaseOrderId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)
  product       Product       @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId, productId])
}

/// Money received from a customer. Never deleted: corrections are made by voiding.
model CustomerPayment {
  id           Int       @id @default(autoincrement())
  tenantId     Int
  customerId   Int
  salesOrderId Int?
  amount       Decimal   @db.Decimal(14, 2)
  method       String    @db.NVarChar(20) // PaymentMethod (src/common/enums.ts; CHECK in migration)
  paidAt       DateTime
  reference    String?   @db.NVarChar(100)
  notes        String?   @db.NVarChar(255)
  createdById  Int
  voidedAt     DateTime?
  voidedById   Int?
  voidReason   String?   @db.NVarChar(255)
  createdAt    DateTime  @default(now())

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customer   Customer    @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  salesOrder SalesOrder? @relation(fields: [salesOrderId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId, customerId, paidAt])
  @@index([tenantId, paidAt])
}

/// Money paid to a supplier. Never deleted: corrections are made by voiding.
model SupplierPayment {
  id              Int       @id @default(autoincrement())
  tenantId        Int
  supplierId      Int
  purchaseOrderId Int?
  amount          Decimal   @db.Decimal(14, 2)
  method          String    @db.NVarChar(20) // PaymentMethod (src/common/enums.ts; CHECK in migration)
  paidAt          DateTime
  reference       String?   @db.NVarChar(100)
  notes           String?   @db.NVarChar(255)
  createdById     Int
  voidedAt        DateTime?
  voidedById      Int?
  voidReason      String?   @db.NVarChar(255)
  createdAt       DateTime  @default(now())

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  supplier      Supplier       @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId, supplierId, paidAt])
  @@index([tenantId, paidAt])
}

model DocumentSequence {
  tenantId  Int
  docType   String @db.NVarChar(20) // DocumentType (src/common/enums.ts; CHECK in migration)
  nextValue Int    @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([tenantId, docType])
}

model ActivityLog {
  id         Int      @id @default(autoincrement())
  tenantId   Int
  userId     Int
  action     String   @db.NVarChar(60)
  entityType String   @db.NVarChar(40)
  entityId   Int
  metadata   String?  @db.NVarChar(Max) // JSON text (CHECK ISJSON in migration)
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId, createdAt])
}
